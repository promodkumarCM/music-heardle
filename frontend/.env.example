# Optional overrides for the home-page support dialog.
# Defaults reuse CurrentUndo's Porotta Set payment page, as requested.
VITE_SUPPORT_PAYMENT_URL=https://payments.cashfree.com/forms/porotta
VITE_SUPPORT_RECIPIENT=CurrentUndo
VITE_SUPPORT_AMOUNT=60
# For direct UPI, set VITE_SUPPORT_PAYMENT_URL= (empty),
# set a verified UPI ID, and set recipient and amount above.
VITE_SUPPORT_UPI_ID=
